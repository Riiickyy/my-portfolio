# Copy this file to .env.local and fill in real values.
# In production, add the same variables in Vercel → Project → Settings → Environment Variables.

# Create a key at https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Where contact form messages are delivered.
# While sending from onboarding@resend.dev this must be the email you signed up to Resend with.
CONTACT_TO_EMAIL=you@example.com
